{
  "name": "wormhole",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted reverse tunnel with a custom multiplexing protocol",
  "workspaces": [
    "protocol",
    "transport",
    "server",
    "inspector",
    "client",
    "bench"
  ],
  "scripts": {
    "server": "npm run start --workspace @wormhole/server",
    "dev": "npm run dev --workspace @wormhole/server",
    "client": "npm run start --workspace @wormhole/client --",
    "gen-cert": "npm run gen-cert --workspace @wormhole/server",
    "bench": "tsx bench/src/run.ts",
    "bench:smoke": "tsx bench/src/run.ts --duration 1 --connections 1 --no-warmup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
